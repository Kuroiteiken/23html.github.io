{
  "name": "proto23",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js && node scripts/build-site.js",
    "build:game": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "check": "node --check js/game.js && node tests/check-changelog.js && node tests/check-game-regressions.js && node tests/check-i18n.js && node scripts/check-refs.js && node scripts/check-flags.js && node scripts/check-economy.js && node scripts/check-combat.js && node tests/check-version.js && npm run test:dev-server && npm run test:save && npm run test:callbacks && npm run test:actions && eslint js scripts tests && stylelint css/game.css && npm run check:format",
    "check:format": "prettier --check . --ignore-path .gitignore",
    "format": "prettier --write . --ignore-path .gitignore",
    "serve": "node scripts/serve.js",
    "test:browser": "npm run build && node tests/browser-smoke-test.js",
    "test:dev-server": "node --test tests/dev-server.test.js",
    "test:save": "node --test tests/save-format.test.js",
    "test:callbacks": "node --test tests/callbacks.test.js",
    "test:actions": "node --test tests/actions.test.js"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "color-function-notation": "modern",
      "font-family-no-missing-generic-family-keyword": null,
      "no-descending-specificity": null,
      "property-no-vendor-prefix": null,
      "rule-empty-line-before": null,
      "selector-class-pattern": null,
      "selector-id-pattern": null,
      "selector-pseudo-element-no-unknown": [
        true,
        {
          "ignorePseudoElements": [
            "-webkit-scrollbar",
            "-webkit-scrollbar-track",
            "-webkit-scrollbar-thumb"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "espree": "^11.2.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
